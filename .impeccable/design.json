  "narrative": {
    "northStar": "The Warm Instrument Atlas",
    "overview": "A warm, precise instrument for exploring cybersecurity briefs. Parchment text, fine olive-brown rules, and small Recursive controls keep dense information readable against a warm black field. Orange identifies interactions, selected objects, and important scores.\n\nThe interface feels like a working atlas: radial geometry, hexagonal anchors, and quiet numeric metadata provide orientation. Panels belong to the same flat material as the workspace; their boundaries come from tone and rules.",
    "keyCharacteristics": [
      "Warm dark surfaces with parchment text.",
      "One self-hosted variable family, Recursive.",
      "Compact controls and tabular numeric metadata.",
      "Fine geometric drawing with flat, ruled panels."
    ],
    "rules": [
      {
        "name": "The Interaction Orange Rule",
        "body": "Use orange for interactive identifiers, selection, focus, and score emphasis. Keep passive structure in the parchment and olive-brown family.",
        "section": "colors"
      },
      {
        "name": "The Shared Instrument Rule",
        "body": "Use Recursive for headings, controls, prose, and map labels; distinguish roles with size, weight, and spacing.",
        "section": "typography"
      },
      {
        "name": "The Ruled Surface Rule",
        "body": "Separate panels and rows with tone and fine borders. The implementation uses no box shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do reuse the eight CSS custom properties for common interface colors.",
      "Do keep numeric scores and counts aligned with tabular numerals.",
      "Do retain visible focus indicators and respect reduced-motion preferences.",
      "Do keep map geometry and connections mounted when moving the camera into a category."
    ],
    "donts": [
      "Don't introduce additional accent hues into this established palette.",
      "Don't replace the persistent map with an isolated category diagram.",
      "Don't treat tiny SVG coordinate-space text as an interface text-size token.",
      "Don't add decorative shadows or large rounded cards to the flat atlas material."
    ]
  }
